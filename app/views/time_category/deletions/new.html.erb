<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".delete_time_category"), subtitle: t(".explanation", category_name: @time_category.name)) %>

  <% dialog.with_body do %>
    <%= styled_form_with url: time_category_deletions_path(@time_category),
                         data: {
                           turbo: false,
                           controller: "deletion",
                           deletion_submit_text_when_not_replacing_value: t(".delete_and_leave_uncategorized", category_name: @time_category.name),
                           deletion_submit_text_when_replacing_value: t(".delete_and_recategorize", category_name: @time_category.name)
                         } do |f| %>
      <%= f.collection_select :replacement_time_category_id,
          @time_categories,
          :id, :name_with_parent,
          { prompt: t(".replacement_prompt"), label: t(".category"), container_class: "mb-4" },
          data: { deletion_target: "replacementField", action: "deletion#chooseSubmitButton" } %>

      <%= render DS::Button.new(
        variant: "destructive",
        text: t(".delete_and_leave_uncategorized", category_name: @time_category.name),
        full_width: true,
        data: { deletion_target: "destructiveSubmitButton" }
      ) %>

      <%= render DS::Button.new(
        text: t(".delete_and_recategorize", category_name: @time_category.name),
        data: { deletion_target: "safeSubmitButton" },
        hidden: true,
        full_width: true
      ) %>
    <% end %>
  <% end %>
<% end %>
